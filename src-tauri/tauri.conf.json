{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZenIDE",
  "version": "0.1.0",
  "identifier": "com.zenide.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZenIDE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Minimal IDE for Rust, C++ and Python",
    "longDescription": "ZenIDE is a minimal, cross-platform IDE with LSP, DAP debugging, an integrated terminal, git and configurable keybindings for Rust, C++ and Python."
  }
}
